    "driver_source": "import hashlib, importlib, importlib.machinery, json, sys, types\nfrom pathlib import Path\nsdk, prefix, source, stage, case = map(Path, sys.argv[1:])\ncase = str(case)\nsys.path.insert(0, str(sdk)); sys.path.insert(0, str(prefix)); sys.prefix = str(prefix)\nfrom devtools.scripts.installed_noarch import run_tests\nnamespace = 'devtools' if case == 'sdk-collision' else 'suite117_runtime' if case == 'runtime-collision' else 'phmt_test_support'\ntry:\n if case != 'missing-support':\n  if namespace in {'suite117_runtime','suite117_addon'} or namespace in sys.modules or importlib.util.find_spec(namespace) is not None:\n   raise ValueError('support namespace collision')\n  package = types.ModuleType(namespace)\n  package.__package__ = namespace\n  package.__path__ = [str(stage / namespace)]\n  package.__spec__ = importlib.machinery.ModuleSpec(namespace, loader=None, is_package=True)\n  package.__spec__.submodule_search_locations = package.__path__\n  sys.modules[namespace] = package\n hashes = {p.relative_to(stage).as_posix():hashlib.sha256(p.read_bytes()).hexdigest() for p in stage.rglob('*') if p.is_file()}\n def check_support():\n  for name, module in tuple(sys.modules.items()):\n   if name == namespace or name.startswith(namespace + '.'):\n    paths = ([module.__file__] if getattr(module,'__file__',None) else []) + list(getattr(module,'__path__',[]))\n    if not paths or any(not Path(p).resolve().is_relative_to(stage.resolve()) for p in paths):\n     raise ValueError('support origin escaped staged files')\n  for relative, digest in hashes.items():\n   if hashlib.sha256((stage / relative).read_bytes()).hexdigest() != digest:\n    raise ValueError('staged support bytes changed')\n if case != 'missing-support':check_support()\n inventory={'import_name':'suite117_runtime','required_paths':['site-packages/suite117_runtime.py','site-packages/suite117_addon.py'],\n            'installed_tests':{'paths':['tests/test_probe.py'],'pytest_args':['-q']}}\n result = run_tests(source, inventory)\n if case != 'missing-support':check_support()\n print('PROPOSAL_RESULT '+json.dumps({'exit_code':result,'source_root_on_sys_path':str(source) in sys.path,'staging_root_on_sys_path':str(stage) in sys.path,\n       'sdk_namespace_preserved':Path(sys.modules['devtools.scripts.installed_noarch'].__file__).resolve()==sdk/'devtools/scripts/installed_noarch.py'}))\n raise SystemExit(result)\nexcept Exception as error:\n print('PROPOSAL_RESULT '+json.dumps({'error_type':type(error).__name__,'reason':str(error)}));raise SystemExit(1)\n",
